// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChestType {
  AVAILABLE
  SECURE
}

enum MovementType {
  IN
  OUT
  TRANSFER
}

enum MovementReason {
  DAILY_SAVING
  PLANNED_SAVING
  BUFFER_CONSOLIDATION
  GOAL_FUNDING
  WITHDRAWAL
  EXPENSE
  DEBT
  // Money taken out of a chest to pay for an expense (linked by expenseId).
  CHEST_SPENDING
}

enum DebtDirection {
  BORROWED
  LENT
}

enum InterestType {
  NONE
  PERCENT
  FIXED
}

enum UserRole {
  USER
  ADMIN
}

enum GoalLogic {
  ALL
  ANY
}

enum ConditionOperator {
  GTE
  LTE
  EQ
  GT
  LT
  // A text value among the accepted ones ("remote or hybrid").
  IN
}

// Required conditions decide achievement; preferred ones are counted but never
// block it; info ones are only shown.
enum ConditionLevel {
  REQUIRED
  PREFERRED
  INFO
}

// AUTO: achieved when the required conditions hold. CONFIRM: the app says the
// criteria are met and the person confirms.
enum AchievementMode {
  AUTO
  CONFIRM
}

enum GoalImportance {
  LOW
  MEDIUM
  HIGH
}

// What a condition is evaluated against: the person's own situation, or an
// alternative such as a Career opportunity.
enum SubjectType {
  SELF
  OPPORTUNITY
}

enum JudgementResult {
  MET
  GAP
  UNKNOWN
}

// The shared goal engine (Ressources/goal-completion-mechanism.md): a goal is
// achieved when its condition tree holds. Every node uses the same tables.
enum GoalLifecycle {
  TERMINAL
  ONGOING
  MAINTENANCE
}

enum GoalHorizon {
  WEEK
  QUARTER
  YEAR
  SOMEDAY
}

enum ConditionRole {
  COMPLETION
  HEALTH
}

enum Aggregation {
  LATEST
  SUM
  COUNT
  MAX
  MIN
  AVG
  STREAK
  RATIO
}

model Chest {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         ChestType
  isSystem     Boolean         @default(false)
  passwordHash String?
  lockedUntil  DateTime?
  createdAt    DateTime        @default(now())
  movementsOut MoneyMovement[] @relation("SourceChest")
  movementsIn  MoneyMovement[] @relation("DestinationChest")
  expensesPaid Expense[]       @relation("ChestExpenses")
}

model MoneyMovement {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceChestId      String?
  sourceChest        Chest?         @relation("SourceChest", fields: [sourceChestId], references: [id], onDelete: NoAction)
  destinationChestId String?
  destinationChest   Chest?         @relation("DestinationChest", fields: [destinationChestId], references: [id], onDelete: NoAction)
  amount             Decimal
  type               MovementType
  reason             MovementReason
  date               DateTime
  relatedGoalId      String?
  relatedGoal        Goal?          @relation(fields: [relatedGoalId], references: [id], onDelete: NoAction)
  relatedProjectId   String?
  relatedProject     Project?       @relation(fields: [relatedProjectId], references: [id], onDelete: NoAction)
  notes              String?
  // The expense this money paid for, when it was paid from a chest.
  expenseId          String?        @unique
  expense            Expense?       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())
  // Who recorded it when not the person in the app: "assistant" or
  // "api:<key name>". Empty for the person and for what the app does itself.
  origin             String?

  @@index([userId, date])
}

model Goal {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  domain        String           @default("finance")
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  horizon       GoalHorizon      @default(SOMEDAY)
  lifecycle     GoalLifecycle    @default(TERMINAL)
  // Once achieved, stays achieved even if the measurement drops later.
  latch         Boolean          @default(true)
  startDate     DateTime         @default(now())
  deadline      DateTime?
  achievedAt    DateTime?
  abandonedAt   DateTime?
  abandonReason String?
  // Why it matters, in the person's words, and how much (not how urgent).
  why             String?
  importance      GoalImportance?
  achievementMode AchievementMode @default(AUTO)
  // Set by the person: paused (no reminders), or replaced by another goal.
  pausedAt        DateTime?
  supersededAt    DateTime?
  supersededById  String?
  // Personal: counts for the career. Once achieved, Career offers to add it
  // as a skill; the offer is answered once.
  careerRelevant         Boolean   @default(false)
  careerPromptAnsweredAt DateTime?
  // Career: the Finance savings goal that pays for it.
  linkedGoalId           String?
  // The part of life it serves, at most one.
  lifeAreaId             String?
  lifeArea               LifeArea? @relation(fields: [lifeAreaId], references: [id], onDelete: SetNull)
  groups        ConditionGroup[]
  milestones    Milestone[]
  tasks         Task[]
  sessions      Session[]
  movements     MoneyMovement[]
  debts         Debt[]
  opportunities CareerOpportunityGoal[]
  createdAt     DateTime         @default(now())
}

// ALL or ANY of its conditions and child groups. A goal's root groups have
// no parent; a milestone can have its own.
model ConditionGroup {
  id            String           @id @default(cuid())
  goalId        String?
  goal          Goal?            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestoneId   String?
  milestone     Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  parentGroupId String?
  parent        ConditionGroup?  @relation("GroupTree", fields: [parentGroupId], references: [id], onDelete: Cascade)
  children      ConditionGroup[] @relation("GroupTree")
  logic         GoalLogic        @default(ALL)
  role          ConditionRole    @default(COMPLETION)
  conditions    Condition[]

  @@index([goalId])
  @@index([milestoneId])
}

// One number compared to a target: a source (where the values come from),
// an aggregation over a window, an operator.
model Condition {
  id          String            @id @default(cuid())
  groupId     String
  group       ConditionGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // "CHEST_BALANCE" | "BUDGET_EXCEPTIONS" | later "METRIC_SERIES", "SESSIONS"...
  source      String
  // What the source reads, e.g. { "chestId": "..." }.
  sourceRef   Json              @default("{}")
  aggregation Aggregation
  // { "type": "ALL_TIME" } | { "type": "CALENDAR", "unit": "month" } | ...
  window      Json
  operator    ConditionOperator
  target      Decimal
  unit        String?
  floor       Decimal?
  stretch     Decimal?
  // What the person reads, when the measurement alone does not say it.
  label          String?
  level          ConditionLevel      @default(REQUIRED)
  // For IN: the accepted text values.
  acceptedValues Json?
  // Overrides the source's own freshness rule.
  staleAfterDays Int?
  sortOrder      Int                 @default(0)
  judgements     ConditionJudgement[]

  @@index([groupId])
}

// The person's verdict on a condition that cannot be measured, for one
// subject. The latest one counts.
model ConditionJudgement {
  id          String          @id @default(cuid())
  conditionId String
  condition   Condition       @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  subjectType SubjectType     @default(SELF)
  // The opportunity's id when the subject is one.
  subjectId   String?
  result      JudgementResult
  note        String?
  judgedAt    DateTime        @default(now())

  @@index([conditionId, subjectType, subjectId, judgedAt])
}

model Milestone {
  id          String           @id @default(cuid())
  goalId      String
  goal        Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  name        String
  order       Int?
  completedAt DateTime?
  groups      ConditionGroup[]
  tasks       Task[]

  @@index([goalId])
}

// --- Personal ----------------------------------------------------------------

enum TaskStatus {
  OPEN
  DONE
  CARRIED_OVER
  DROPPED
}

// An optional label shared by tasks (and later goals and sessions). Used to
// filter and group, never for logic.
model Category {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  icon      String?
  createdAt DateTime  @default(now())
  tasks     Task[]
  goals     Goal[]
  sessions  Session[]

  @@unique([userId, name])
}

// A completable unit of action. Without a date or a recurrence it waits in
// the inbox.
model Task {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goalId      String?
  goal        Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  // Midnight of the day it is due, on the person's clock.
  dueDate     DateTime?
  // { "kind": "daily" } | { "kind": "weekly", "days": [1, 3, 5] } (1 is Monday)
  // | { "kind": "everyN", "n": 3 }. Counted from dueDate, or from creation.
  recurrence  Json?
  status      TaskStatus       @default(OPEN)
  // Days it slipped to a later day, and why it slipped the last time.
  carryCount  Int              @default(0)
  carryReason String?
  sortOrder   Int              @default(0)
  // Who recorded it when not the person: "assistant" or "api:<key name>".
  origin      String?
  // The node it belongs to: "personal" (Today, the task list) or "career"
  // (a weekly focus item, never shown in Personal).
  domain      String           @default("personal")
  // A Career focus item: the Monday of its week, on the person's clock.
  focusWeek   DateTime?
  // What else it is about, e.g. relatedType "careerOpportunity".
  relatedType String?
  relatedId   String?
  completions TaskCompletion[]
  carries     TaskCarry[]
  createdAt   DateTime         @default(now())

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([userId, domain, focusWeek])
}

// One completion per day a task is done; a recurring task has one per
// occurrence.
model TaskCompletion {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime
  completedAt    DateTime @default(now())

  @@unique([taskId, occurrenceDate])
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  firstName             String?
  lastName              String?
  // An optional nickname, shown in place of the first name. Sign-in is by email.
  username              String?
  // What the person chose to say about themselves. All optional.
  bio                   String?
  occupation            String?
  phone                 String?
  country               String?
  city                  String?
  birthDate             DateTime?
  // A small image as a data URL, shrunk by the browser before upload.
  picture               String?
  role                  UserRole  @default(USER)
  // The last day the person opened the app, and the language it was shown in.
  lastSeenAt            DateTime?
  locale                String?
  // Where the person's days begin and end, e.g. "Africa/Abidjan".
  timeZone              String?
  // The last day whose leftover was moved to the Buffer.
  settledThrough        DateTime?
  // The weekday the Buffer is emptied into the Base Chest. 0 is Sunday.
  bufferSweepDay        Int       @default(0)
  // Personal: how many tasks a day can hold before a warning (never a block),
  // and the last day whose unfinished tasks were moved to the next day.
  dailyTaskCapacity     Int       @default(5)
  tasksSettledThrough   DateTime?
  // Whether the assistant writes this person an evening note and reviews.
  assistantNotes        Boolean   @default(false)
  // The AI provider the person chose for the assistant: 'anthropic', 'openai'...
  assistantProvider     String?
  // What the person asks of their assistant: a name, and instructions.
  assistantName         String?
  assistantInstructions String?
  // Whether the person wants to hear about what is new in the app.
  wantsNews             Boolean   @default(false)
  // Which notifications the person wants. Security notices are always sent.
  notifyMoney           Boolean   @default(true)
  // For administrators: new accounts and new opinions.
  notifyAdmin           Boolean   @default(true)
  notifyCareer          Boolean   @default(true)
  // The day of the weekly reviews: 1 is Monday, 7 is Sunday.
  reviewDay             Int       @default(7)
  // The places a Career "location" condition can accept, in the person's words.
  careerLocations       Json      @default("[]")
  createdAt             DateTime  @default(now())

  incomes           Income[]
  allocations       Allocation[]
  moneyMovements    MoneyMovement[]
  expenses          Expense[]
  chests            Chest[]
  budgetExceptions  BudgetException[]
  goals             Goal[]
  projects          Project[]
  debts             Debt[]
  incomeReceipts    IncomeReceipt[]
  passwordResets    PasswordResetToken[]
  pushSubscriptions PushSubscription[]
  apiTokens         ApiToken[]
  assistantNoteList AssistantNote[]
  feedback          Feedback[]
  notificationLog   NotificationLog[]
  categories        Category[]
  tasks             Task[]
  sessions          Session[]
  metricSeries      MetricSeries[]
  journalEntries    JournalEntry[]
  syncConnectors    SyncConnector[]
  careerFacts       CareerFact[]
  careerEvidence    CareerEvidence[]
  careerOpportunities CareerOpportunity[]
  lifeAreas           LifeArea[]
}

// What was already sent to a person, so the same event is never sent twice.
// The key names the event, e.g. "goal:<id>" or "overspend:2026-10-04".
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

// What a person thinks of the app, for the administrators to read.
model Feedback {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // From 1 to 5 stars, when given.
  rating    Int?
  // 'idea', 'problem', 'praise' or 'other'.
  kind      String
  message   String
  // When an administrator read it.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

// Settings of the whole app, changed by administrators. Text by key, e.g.
// "assistant.role".
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// What the assistant wrote to a person on its own: an evening note, or the
// review of a week or a month.
model AssistantNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'daily', 'weekly' or 'monthly'.
  kind      String
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum ApiScope {
  READ
  WRITE
}

// A key that lets a program (an assistant, a script) use the API as its
// owner. Only a hash is kept: the key itself is shown once, when created.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  // READ can only look. WRITE can also record and send notifications.
  scope      ApiScope  @default(READ)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

// One device that agreed to receive notifications. The browser gives the
// address to send to and the keys to encrypt with.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// A one-time link to choose a new password. Only a hash of the link's secret
// is kept, so the table alone cannot be used to take over an account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// One attempt at something that is limited: signing up, signing in, asking
// for a reset. `key` names the action and who tried, e.g. "signup:1.2.3.4".
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Income {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  source       String
  amount       Decimal
  frequency    String // monthly | weekly | occasional | recurring
  expectedDate DateTime?
  actualDate   DateTime?
  status       String // expected | received
  notes        String?
  projectId    String? // optional: income can come from a project
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: NoAction)
  // Day of the month the income usually arrives (1-31). None for money that
  // came once (a gift): it is counted as received when recorded, and is not
  // part of the monthly plan.
  payDay       Int?
  receipts     IncomeReceipt[]
  createdAt    DateTime        @default(now())
}

// One confirmed arrival of an income, for one calendar month.
model IncomeReceipt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeId    String
  income      Income   @relation(fields: [incomeId], references: [id], onDelete: NoAction)
  amount      Decimal
  // First day of the month the receipt counts for.
  periodStart DateTime
  receivedAt  DateTime
  createdAt   DateTime @default(now())

  @@unique([incomeId, periodStart])
}

// Money borrowed from someone (BORROWED) or lent to someone (LENT).
model Debt {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction     DebtDirection
  // Free text for now: a person, a company, an app.
  counterparty  String
  principal     Decimal
  interestType  InterestType  @default(NONE)
  // A percentage of the principal, or a fixed amount, depending on the type.
  interestValue Decimal       @default(0)
  takenAt       DateTime
  dueDate       DateTime?
  // Borrowed money added to that day's spending budget instead of a chest.
  toDailyBudget Boolean       @default(false)
  notes         String?
  // The goal the money was borrowed for, when there is one.
  goalId        String?
  goal          Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  payments      DebtPayment[]
  createdAt     DateTime      @default(now())
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Decimal
  date      DateTime
  createdAt DateTime @default(now())
}

model Allocation {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  amount     Decimal
  period     String // monthly | weekly | daily
  category   String // fixed | subscription | daily_living | savings | custom
  startDate  DateTime
  endDate    DateTime?
  recurrence String?
  notes      String?
  expenses   Expense[]
  createdAt  DateTime  @default(now())
}

model Expense {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Decimal
  category          String
  date              DateTime
  allocationId      String?
  allocation        Allocation?       @relation(fields: [allocationId], references: [id], onDelete: NoAction)
  projectId         String?
  project           Project?          @relation(fields: [projectId], references: [id], onDelete: NoAction)
  description       String?
  notes             String?
  // The exception this expense caused by going over the day's budget.
  exceptions        BudgetException[]
  // Paid with money from a chest instead of the day's budget. The name stays
  // when the chest is deleted, so the expense keeps saying how it was paid.
  paidFromChestId   String?
  paidFromChest     Chest?            @relation("ChestExpenses", fields: [paidFromChestId], references: [id], onDelete: SetNull)
  paidFromChestName String?
  // The money that left the chest for it.
  chestMovement     MoneyMovement?
  createdAt         DateTime          @default(now())
  // Who recorded it when not the person in the app: "assistant" or
  // "api:<key name>". Empty for the person and for what the app does itself.
  origin            String?

  @@index([userId, date])
}

model BudgetException {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  plannedAmount Decimal
  actualAmount  Decimal
  difference    Decimal
  category      String
  reason        String?
  context       String?
  resolution    String?
  // The expense that went over, when the exception comes from one.
  expenseId     String?
  expense       Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  // Who recorded it when not the person in the app: "assistant" or
  // "api:<key name>". Empty for the person and for what the app does itself.
  origin        String?

  @@index([userId, date])
}

model Project {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  notes     String?
  incomes   Income[]
  expenses  Expense[]
  movements MoneyMovement[]
  createdAt DateTime        @default(now())
}

// Time spent on something: started and stopped, or logged afterwards.
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId      String?
  goal        Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // On the person's clock. No end yet means it is still running.
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int?
  note        String?
  origin      String?
  createdAt   DateTime  @default(now())

  @@index([userId, startedAt])
}

enum MetricProvider {
  MANUAL
  SYNC
  DERIVED
}

// A named number followed over time: a rating, a score, words learned.
model MetricSeries {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  label       String
  unit        String?
  provider    MetricProvider @default(MANUAL)
  // Where a synced measure comes from.
  connectorId String?
  connector   SyncConnector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  entries     MetricEntry[]
  createdAt   DateTime       @default(now())

  @@unique([userId, key])
}

model MetricEntry {
  id         String       @id @default(cuid())
  seriesId   String
  series     MetricSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  value      Decimal
  recordedAt DateTime
  // "manual", or the service it was synced from.
  source     String       @default("manual")
  createdAt  DateTime     @default(now())

  @@index([seriesId, recordedAt])
}

enum JournalType {
  FREE
  DAILY
  DECISION
  IDEA
  REVIEW
  // A line in the Career quick log.
  CAREER_LOG
}

// A journal entry. Open by default; a secured one asks for its password
// before its text is shown (friction, not encryption).
model JournalEntry {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         JournalType   @default(FREE)
  title        String?
  // Links to goals and tasks are written in the text as @[Label](goal:id).
  body         String
  mood         Int?
  energy       Int?
  isSecured    Boolean       @default(false)
  passwordHash String?
  // The day it is about, at midnight on the person's clock.
  entryDate    DateTime
  // For a decision: when to look at it again.
  reviewOn     DateTime?
  origin       String?
  links        JournalLink[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, entryDate])
}

// What an entry mentions, so the goal's or task's page can list it.
model JournalLink {
  id         String       @id @default(cuid())
  entryId    String
  entry      JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String

  @@index([targetType, targetId])
  @@index([entryId])
}

// Each time an unfinished task slipped to a later day, and why. The reviews
// count these; the task itself only keeps its latest reason.
model TaskCarry {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // The day it was moved to, and how many days it slipped to get there.
  carriedTo DateTime
  days      Int
  reason    String?
  createdAt DateTime @default(now())

  @@index([taskId, carriedTo])
}

// An outside account a measure is read from, e.g. a chess.com username and
// the time control whose rating it follows. Synced once a day, and on demand.
model SyncConnector {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "chess.com"
  provider     String
  // The username on that service.
  accountRef   String
  // { "timeControl": "rapid" }
  config       Json
  lastSyncedAt DateTime?
  lastError    String?
  series       MetricSeries[]
  createdAt    DateTime       @default(now())

  @@index([userId])
}

// An action sent from a device's outbox (offline mode), by the id the device
// gave it. Written before the action runs, so the same action sent twice
// (a retry after a lost answer) is only done once.
// --- Career (Ressources/career-node-specification.md) --------------------------

enum CareerFactKind {
  POSITION
  QUALIFICATION
  SKILL
  EXPERIENCE
}

// self: said by the person; documented: evidence is linked; confirmed: the
// person marked it as checked.
enum CareerFactSource {
  SELF
  DOCUMENTED
  CONFIRMED
}

// Something true about the person's professional situation, from a date and
// possibly until one. Facts are ended, never deleted: they are the history.
model CareerFact {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                CareerFactKind
  title               String
  details             String?
  // Midnight on the person's clock. No end date: still true.
  validFrom           DateTime
  validTo             DateTime?
  source              CareerFactSource     @default(SELF)
  // Among current positions, the one goals compare with.
  isPrimary           Boolean              @default(false)
  lastReviewedAt      DateTime?
  // Position.
  organisation        String?
  // Per month, in XOF. Sensitive: never kept on a device.
  monthlyCompensation Decimal?
  workArrangement     String?
  contractType        String?
  weeklyHours         Int?
  location            String?
  financeIncomeId     String?
  // Qualification.
  issuer              String?
  obtainedAt          DateTime?
  expiresAt           DateTime?
  // Skill: the level in the person's own words.
  level               String?
  // Experience: the position it happened in.
  positionId          String?
  origin              String?
  evidence            CareerEvidenceLink[]
  createdAt           DateTime             @default(now())

  @@index([userId, kind])
}

// A link (and what it shows) that supports one or more facts.
model CareerEvidence {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  description String?
  addedAt     DateTime             @default(now())
  origin      String?
  facts       CareerEvidenceLink[]

  @@index([userId])
}

model CareerEvidenceLink {
  evidenceId String
  evidence   CareerEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  factId     String
  fact       CareerFact     @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@id([evidenceId, factId])
  @@index([factId])
}

enum CareerOpportunityKind {
  JOB
  PROMOTION
  FREELANCE
  TRAINING
  OTHER
}

enum CareerOpportunityStatus {
  FOUND
  APPLIED
  INTERVIEWING
  OFFER
  CLOSED
}

// An opening or an offer, with its terms for the same dimensions as a
// position, so goals can be compared with it side by side.
model CareerOpportunity {
  id                  String                  @id @default(cuid())
  userId              String
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  organisation        String?
  kind                CareerOpportunityKind   @default(JOB)
  sourceUrl           String?
  notes               String?
  // Midnight on the person's clock: reply, application or start date.
  deadline            DateTime?
  status              CareerOpportunityStatus @default(FOUND)
  // When closed: accepted, declined, rejected, withdrawn, lapsed.
  outcome             String?
  // Terms. Pay is per month, in XOF; sensitive like a position's.
  monthlyCompensation Decimal?
  workArrangement     String?
  contractType        String?
  weeklyHours         Int?
  location            String?
  origin              String?
  goals               CareerOpportunityGoal[]
  statusChanges       CareerStatusChange[]
  createdAt           DateTime                @default(now())
  // When the terms or details last changed.
  updatedAt           DateTime                @updatedAt

  @@index([userId, status])
}

model CareerOpportunityGoal {
  opportunityId String
  opportunity   CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  goalId        String
  goal          Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([opportunityId, goalId])
  @@index([goalId])
}

model CareerStatusChange {
  id            String                  @id @default(cuid())
  opportunityId String
  opportunity   CareerOpportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        CareerOpportunityStatus
  outcome       String?
  changedAt     DateTime                @default(now())

  @@index([opportunityId, changedAt])
}

// A part of the person's life they invest in (Projection spec §4): Tech,
// Music, Family. Goals in every node, and later projects and ideas, belong to
// one area at most; tasks and sessions inherit it through their goal.
model LifeArea {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // "In 5 years…", in the person's words.
  statement String?
  // A colour and an icon from the app's own lists.
  color     String?
  icon      String?
  sortOrder Int      @default(0)
  goals     Goal[]
  createdAt DateTime @default(now())

  @@index([userId, sortOrder])
}

// What happened that matters for security: failed sign-ins, limits reached,
// wrong journal passwords, account changes (security plan, decision D4). No
// link to the user, so failures for unknown emails can be kept too.
model SecurityEvent {
  id        String   @id @default(cuid())
  kind      String
  userId    String?
  subject   String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, subject, createdAt])
}

model SyncReceipt {
  id        String   @id
  userId    String
  action    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
