// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChestType {
  AVAILABLE
  SECURE
}

enum MovementType {
  IN
  OUT
  TRANSFER
}

enum MovementReason {
  DAILY_SAVING
  PLANNED_SAVING
  BUFFER_CONSOLIDATION
  GOAL_FUNDING
  WITHDRAWAL
  EXPENSE
  DEBT
  // Money taken out of a chest to pay for an expense (linked by expenseId).
  CHEST_SPENDING
}

enum DebtDirection {
  BORROWED
  LENT
}

enum InterestType {
  NONE
  PERCENT
  FIXED
}

enum UserRole {
  USER
  ADMIN
}

enum GoalLogic {
  ALL
  ANY
}

enum ConditionOperator {
  GTE
  LTE
  EQ
  GT
  LT
}

// The shared goal engine (Ressources/goal-completion-mechanism.md): a goal is
// achieved when its condition tree holds. Every node uses the same tables.
enum GoalLifecycle {
  TERMINAL
  ONGOING
  MAINTENANCE
}

enum GoalHorizon {
  WEEK
  QUARTER
  YEAR
  SOMEDAY
}

enum ConditionRole {
  COMPLETION
  HEALTH
}

enum Aggregation {
  LATEST
  SUM
  COUNT
  MAX
  MIN
  AVG
  STREAK
  RATIO
}

model Chest {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  name         String
  type         ChestType
  isSystem     Boolean         @default(false)
  passwordHash String?
  lockedUntil  DateTime?
  createdAt    DateTime        @default(now())
  movementsOut MoneyMovement[] @relation("SourceChest")
  movementsIn  MoneyMovement[] @relation("DestinationChest")
  expensesPaid Expense[]       @relation("ChestExpenses")
}

model MoneyMovement {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  sourceChestId      String?
  sourceChest        Chest?         @relation("SourceChest", fields: [sourceChestId], references: [id])
  destinationChestId String?
  destinationChest   Chest?         @relation("DestinationChest", fields: [destinationChestId], references: [id])
  amount             Decimal
  type               MovementType
  reason             MovementReason
  date               DateTime
  relatedGoalId      String?
  relatedGoal        Goal?          @relation(fields: [relatedGoalId], references: [id])
  relatedProjectId   String?
  relatedProject     Project?       @relation(fields: [relatedProjectId], references: [id])
  notes              String?
  // The expense this money paid for, when it was paid from a chest.
  expenseId          String?        @unique
  expense            Expense?       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())
  // Who recorded it when not the person in the app: "assistant" or
  // "api:<key name>". Empty for the person and for what the app does itself.
  origin             String?
}

model Goal {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  name          String
  domain        String           @default("finance")
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  horizon       GoalHorizon      @default(SOMEDAY)
  lifecycle     GoalLifecycle    @default(TERMINAL)
  // Once achieved, stays achieved even if the measurement drops later.
  latch         Boolean          @default(true)
  startDate     DateTime         @default(now())
  deadline      DateTime?
  achievedAt    DateTime?
  abandonedAt   DateTime?
  abandonReason String?
  groups        ConditionGroup[]
  milestones    Milestone[]
  tasks         Task[]
  sessions      Session[]
  movements     MoneyMovement[]
  debts         Debt[]
  createdAt     DateTime         @default(now())
}

// ALL or ANY of its conditions and child groups. A goal's root groups have
// no parent; a milestone can have its own.
model ConditionGroup {
  id            String           @id @default(cuid())
  goalId        String?
  goal          Goal?            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestoneId   String?
  milestone     Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  parentGroupId String?
  parent        ConditionGroup?  @relation("GroupTree", fields: [parentGroupId], references: [id], onDelete: Cascade)
  children      ConditionGroup[] @relation("GroupTree")
  logic         GoalLogic        @default(ALL)
  role          ConditionRole    @default(COMPLETION)
  conditions    Condition[]

  @@index([goalId])
  @@index([milestoneId])
}

// One number compared to a target: a source (where the values come from),
// an aggregation over a window, an operator.
model Condition {
  id          String            @id @default(cuid())
  groupId     String
  group       ConditionGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // "CHEST_BALANCE" | "BUDGET_EXCEPTIONS" | later "METRIC_SERIES", "SESSIONS"...
  source      String
  // What the source reads, e.g. { "chestId": "..." }.
  sourceRef   Json              @default("{}")
  aggregation Aggregation
  // { "type": "ALL_TIME" } | { "type": "CALENDAR", "unit": "month" } | ...
  window      Json
  operator    ConditionOperator
  target      Decimal
  unit        String?
  floor       Decimal?
  stretch     Decimal?

  @@index([groupId])
}

model Milestone {
  id          String           @id @default(cuid())
  goalId      String
  goal        Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  name        String
  order       Int?
  completedAt DateTime?
  groups      ConditionGroup[]
  tasks       Task[]

  @@index([goalId])
}

// --- Personal ----------------------------------------------------------------

enum TaskStatus {
  OPEN
  DONE
  CARRIED_OVER
  DROPPED
}

// An optional label shared by tasks (and later goals and sessions). Used to
// filter and group, never for logic.
model Category {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  name      String
  color     String?
  icon      String?
  createdAt DateTime  @default(now())
  tasks     Task[]
  goals     Goal[]
  sessions  Session[]

  @@unique([userId, name])
}

// A completable unit of action. Without a date or a recurrence it waits in
// the inbox.
model Task {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  title       String
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goalId      String?
  goal        Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  // Midnight of the day it is due, on the person's clock.
  dueDate     DateTime?
  // { "kind": "daily" } | { "kind": "weekly", "days": [1, 3, 5] } (1 is Monday)
  // | { "kind": "everyN", "n": 3 }. Counted from dueDate, or from creation.
  recurrence  Json?
  status      TaskStatus       @default(OPEN)
  // Days it slipped to a later day, and why it slipped the last time.
  carryCount  Int              @default(0)
  carryReason String?
  sortOrder   Int              @default(0)
  // Who recorded it when not the person: "assistant" or "api:<key name>".
  origin      String?
  completions TaskCompletion[]
  createdAt   DateTime         @default(now())

  @@index([userId, dueDate])
  @@index([userId, status])
}

// One completion per day a task is done; a recurring task has one per
// occurrence.
model TaskCompletion {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime
  completedAt    DateTime @default(now())

  @@unique([taskId, occurrenceDate])
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  firstName             String?
  lastName              String?
  // An optional nickname, shown in place of the first name. Sign-in is by email.
  username              String?
  // What the person chose to say about themselves. All optional.
  bio                   String?
  occupation            String?
  phone                 String?
  country               String?
  city                  String?
  birthDate             DateTime?
  // A small image as a data URL, shrunk by the browser before upload.
  picture               String?
  role                  UserRole  @default(USER)
  // The last day the person opened the app, and the language it was shown in.
  lastSeenAt            DateTime?
  locale                String?
  // Where the person's days begin and end, e.g. "Africa/Abidjan".
  timeZone              String?
  // The last day whose leftover was moved to the Buffer.
  settledThrough        DateTime?
  // The weekday the Buffer is emptied into the Base Chest. 0 is Sunday.
  bufferSweepDay        Int       @default(0)
  // Personal: how many tasks a day can hold before a warning (never a block),
  // and the last day whose unfinished tasks were moved to the next day.
  dailyTaskCapacity     Int       @default(5)
  tasksSettledThrough   DateTime?
  // Whether the assistant writes this person an evening note and reviews.
  assistantNotes        Boolean   @default(false)
  // The AI provider the person chose for the assistant: 'anthropic', 'openai'...
  assistantProvider     String?
  // What the person asks of their assistant: a name, and instructions.
  assistantName         String?
  assistantInstructions String?
  // Whether the person wants to hear about what is new in the app.
  wantsNews             Boolean   @default(false)
  // Which notifications the person wants. Security notices are always sent.
  notifyMoney           Boolean   @default(true)
  // For administrators: new accounts and new opinions.
  notifyAdmin           Boolean   @default(true)
  createdAt             DateTime  @default(now())

  incomes           Income[]
  allocations       Allocation[]
  moneyMovements    MoneyMovement[]
  expenses          Expense[]
  chests            Chest[]
  budgetExceptions  BudgetException[]
  goals             Goal[]
  projects          Project[]
  debts             Debt[]
  incomeReceipts    IncomeReceipt[]
  passwordResets    PasswordResetToken[]
  pushSubscriptions PushSubscription[]
  apiTokens         ApiToken[]
  assistantNoteList AssistantNote[]
  feedback          Feedback[]
  notificationLog   NotificationLog[]
  categories        Category[]
  tasks             Task[]
  sessions          Session[]
  metricSeries      MetricSeries[]
}

// What was already sent to a person, so the same event is never sent twice.
// The key names the event, e.g. "goal:<id>" or "overspend:2026-10-04".
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

// What a person thinks of the app, for the administrators to read.
model Feedback {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // From 1 to 5 stars, when given.
  rating    Int?
  // 'idea', 'problem', 'praise' or 'other'.
  kind      String
  message   String
  // When an administrator read it.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

// Settings of the whole app, changed by administrators. Text by key, e.g.
// "assistant.role".
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// What the assistant wrote to a person on its own: an evening note, or the
// review of a week or a month.
model AssistantNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'daily', 'weekly' or 'monthly'.
  kind      String
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum ApiScope {
  READ
  WRITE
}

// A key that lets a program (an assistant, a script) use the API as its
// owner. Only a hash is kept: the key itself is shown once, when created.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  // READ can only look. WRITE can also record and send notifications.
  scope      ApiScope  @default(READ)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

// One device that agreed to receive notifications. The browser gives the
// address to send to and the keys to encrypt with.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// A one-time link to choose a new password. Only a hash of the link's secret
// is kept, so the table alone cannot be used to take over an account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// One attempt at something that is limited: signing up, signing in, asking
// for a reset. `key` names the action and who tried, e.g. "signup:1.2.3.4".
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Income {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  source       String
  amount       Decimal
  frequency    String // monthly | weekly | occasional | recurring
  expectedDate DateTime?
  actualDate   DateTime?
  status       String // expected | received
  notes        String?
  projectId    String? // optional: income can come from a project
  project      Project?        @relation(fields: [projectId], references: [id])
  // Day of the month the income usually arrives (1-31).
  payDay       Int             @default(1)
  receipts     IncomeReceipt[]
  createdAt    DateTime        @default(now())
}

// One confirmed arrival of an income, for one calendar month.
model IncomeReceipt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  incomeId    String
  income      Income   @relation(fields: [incomeId], references: [id])
  amount      Decimal
  // First day of the month the receipt counts for.
  periodStart DateTime
  receivedAt  DateTime
  createdAt   DateTime @default(now())

  @@unique([incomeId, periodStart])
}

// Money borrowed from someone (BORROWED) or lent to someone (LENT).
model Debt {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  direction     DebtDirection
  // Free text for now: a person, a company, an app.
  counterparty  String
  principal     Decimal
  interestType  InterestType  @default(NONE)
  // A percentage of the principal, or a fixed amount, depending on the type.
  interestValue Decimal       @default(0)
  takenAt       DateTime
  dueDate       DateTime?
  // Borrowed money added to that day's spending budget instead of a chest.
  toDailyBudget Boolean       @default(false)
  notes         String?
  // The goal the money was borrowed for, when there is one.
  goalId        String?
  goal          Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  payments      DebtPayment[]
  createdAt     DateTime      @default(now())
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Decimal
  date      DateTime
  createdAt DateTime @default(now())
}

model Allocation {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  name       String
  amount     Decimal
  period     String // monthly | weekly | daily
  category   String // fixed | subscription | daily_living | savings | custom
  startDate  DateTime
  endDate    DateTime?
  recurrence String?
  notes      String?
  expenses   Expense[]
  createdAt  DateTime  @default(now())
}

model Expense {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  amount            Decimal
  category          String
  date              DateTime
  allocationId      String?
  allocation        Allocation?       @relation(fields: [allocationId], references: [id])
  projectId         String?
  project           Project?          @relation(fields: [projectId], references: [id])
  description       String?
  notes             String?
  // The exception this expense caused by going over the day's budget.
  exceptions        BudgetException[]
  // Paid with money from a chest instead of the day's budget. The name stays
  // when the chest is deleted, so the expense keeps saying how it was paid.
  paidFromChestId   String?
  paidFromChest     Chest?            @relation("ChestExpenses", fields: [paidFromChestId], references: [id], onDelete: SetNull)
  paidFromChestName String?
  // The money that left the chest for it.
  chestMovement     MoneyMovement?
  createdAt         DateTime          @default(now())
  // Who recorded it when not the person in the app: "assistant" or
  // "api:<key name>". Empty for the person and for what the app does itself.
  origin            String?
}

model BudgetException {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime
  plannedAmount Decimal
  actualAmount  Decimal
  difference    Decimal
  category      String
  reason        String?
  context       String?
  resolution    String?
  // The expense that went over, when the exception comes from one.
  expenseId     String?
  expense       Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  // Who recorded it when not the person in the app: "assistant" or
  // "api:<key name>". Empty for the person and for what the app does itself.
  origin        String?
}

model Project {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  name      String
  notes     String?
  incomes   Income[]
  expenses  Expense[]
  movements MoneyMovement[]
  createdAt DateTime        @default(now())
}

// Time spent on something: started and stopped, or logged afterwards.
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  goalId      String?
  goal        Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // On the person's clock. No end yet means it is still running.
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int?
  note        String?
  origin      String?
  createdAt   DateTime  @default(now())

  @@index([userId, startedAt])
}

enum MetricProvider {
  MANUAL
  SYNC
  DERIVED
}

// A named number followed over time: a rating, a score, words learned.
model MetricSeries {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  key       String
  label     String
  unit      String?
  provider  MetricProvider @default(MANUAL)
  entries   MetricEntry[]
  createdAt DateTime       @default(now())

  @@unique([userId, key])
}

model MetricEntry {
  id         String       @id @default(cuid())
  seriesId   String
  series     MetricSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  value      Decimal
  recordedAt DateTime
  // "manual", or the service it was synced from.
  source     String       @default("manual")
  createdAt  DateTime     @default(now())

  @@index([seriesId, recordedAt])
}
